{
  "name": "mandi-saathi",
  "version": "0.1.0",
  "private": true,
  "description": "Voice agent that tells small farmers what each selling option leaves in their hand, and pools nearby farmers for shared trucks and warehouse loans.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:types": "npx -y supabase gen types typescript --linked > lib/supabase/types.ts",
