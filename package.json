    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.15.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.0",
    "prettier": "^3.3.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
